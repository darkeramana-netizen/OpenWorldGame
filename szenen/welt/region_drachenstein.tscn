zeilen = PackedStringArray("a: Du warst doch schon im Bergfried. Stimmt es, dass es unter Ashenveil Gänge bis in die Sümpfe gibt?", "b: Woher soll ich das wissen? Und warum willst du das wissen?", "a: Nur so. Und hier in Drachenstein? Unter der Oberer Burg, wo kommt man da heraus?", "b: Frag den Kammerhüter, wenn du es so genau wissen willst.")
bedingung = "kerrin_anwaerter,!kerrin_gefasst"
flag_gehoert = "beobachtung_kerrin"
akte_text = "Belauscht im Hof: Kerrin Fahl, für den du bürgst, fragt den Knappen Tilo Brenn nach den Fluchtgängen. Ein Warnzeichen."

